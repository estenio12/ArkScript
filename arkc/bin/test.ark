module System;

    extern fun "console.log($1)" print(value: any) -> void;

    pub struct Opt<T>:
        __valid: bool;
        __content: T;
    end

    pub fun (opt: Opt<T>) isValid() -> bool:
        return opt::__valid;
    end

    pub fun (opt: Opt<T>) getContent() -> T:
        return opt::__content;
    end
end

module person;

    pub struct Person:
        name: string;
        age: int;
    end

    fun (p: Person) age() -> int:
        return p::age;
    end

end

module main;

    use sys = System;
    using person = Person;

    pub fun main() -> void:
        var p = person{};
        var age = str(p::GetAge());
        sys::print(p::GetAge());
    end

end