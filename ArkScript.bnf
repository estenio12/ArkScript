<identifier>     = [a-zA-Z_][a-zA-Z0-9_]*
<literal-int>    = ["-"] [0-9]+
<literal-float>  = ["-"] [0-9]+ "." [0-9]+
<literal-string> = '"' [^'"'\\]* '"'
<literal-bool>   = "true" | "false"
<literal-text>   = "`" [^\'`']* <literal-string> "`"

<type-native>    = "int" |  "float" | "string" | "bool"
<type-void>      = "void"

<program>        = <module-decl> <module-stmt>*
<module-decl>    = "module" <identifier> ( "::" <identifier> )* ";"
<module-stmt>    = [ "pub" ] (<readonly-decl> | <fun-decl> | <struct-decl>)

<block>          = ":" <statement>* "end"
<statement>      = <const-decl> | <var-decl> | <assign-stmt> | <call-stmt> | <return-stmt>
<assign-stmt>    = <identifier> "=" <expression> ";"
<call-stmt>      = <fun-call> ";"

<readonly-decl>  = "readonly" <identifier> ":" <type-native> "=" <expression> ";"
<const-decl>     = "const" <identifier> ":" <type-native> "=" <expression> ";"
<var-decl>       = "var" <identifier> ":" <type-native> ["=" <expression>] ";"

<fun-decl>       = "fun" ["(" <identifier> ":" <struct-identifier> ")"] <identifier> "(" [ <parameter-list> ] ")" "->" ( <type-native> | <type-void> ) <block>
<fun-call>       = [<struct-identifier> "::"] <identifier> "(" [ <arg-list> ] ")"
<arg-list>       = <expression> ( "," <expression> )*

<parameter>      = <identifier> ":" <type-native>
<parameter-list> = <parameter> ( "," <parameter> )*

<return-stmt>    = "return" [ <expression> ] ";"

<expression>     = ["!"] (<prefix-expr> ( <infix-op> <expression> )*)

<prefix-expr>    = <fun-call>
                   | <identifier>
                   | <literal-int>
                   | <literal-float>
                   | <literal-string>
                   | <literal-bool>
                   | "(" <expression> ")"

<infix-op>       = "+" | "-" | "*" | "/" | "||" | "&&" | ">" | "<" | ">=" | "<=" | "==" | "!="

<struct-decl>    = ["pub"] "struct" <identifier> (":" <struct-inherit>) <struct-block>
<struct-identifier> = <identifier>
<struct-inherit> = ["!"] <struct-identifier> ("," <struct-inherit>)*
<struct-block>   = ":" <struct-stmt>* "end"
<struct-stmt>    = <struct-property-decl>*
<struct-property-decl> = <identifier> ":" <type-native> ("=" (<identifier> | <literal-int> | <literal-float> | <literal-string> | <literal-bool> | <literal-text>)) ";"

<module-import>  = "use" <identifier> ("::" <identifier>)*


